config {
    id "urn:com.arcadiaeditions:payments:processing"
    version "0.0.0"
    title "Arcadia Editions - Payments Processing"
    moduleBasePackage "com.arcadiaeditions.payments.processing"
    persistence jpa
    layout HexagonalProjectLayout

    plugins {
//        /** Generates an OpenAPI 3.0 specification from this ZDL model. */
//        ZDLToOpenAPIPlugin {
//            idType integer
//            idTypeFormat int64
//            targetFile "./payments-processing-openapi.yml"
//        }
    }
}

apis {
    zdl client OrdersCheckoutZdl "./orders-checkout-domain-model.zdl"
    zdl client FulfillmentShippingZdl "./fulfillment-shipping-domain-model.zdl"
}

@aggregate
@lifecycle(field: status, initial: AUTHORIZATION_REQUESTED)
entity Payment {
    orderId String required unique
    customerId String required
    paymentMethodId String required
    /** Carried so PaymentCaptured can drive the order confirmation e-mail. */
    customerEmail String required
    amount BigDecimal required
    currency String required
    status PaymentStatus required
    providerReference String
    attemptCount Integer required
    authorizedAt Instant
    declinedAt Instant
    failedAt Instant
    capturedAt Instant
    voidedAt Instant
    voidFailedAt Instant
    failureReason String
}

enum PaymentStatus {
    AUTHORIZATION_REQUESTED
    AUTHORIZED
    DECLINED
    FAILED
    RETRY_EXHAUSTED
    CAPTURED
    CAPTURE_FAILED
    VOIDED
    /** The processor refused the void; ops release the hold by hand. Terminal. */
    VOID_FAILED
}

input AuthorizePaymentInput {
    orderId String required
    customerId String required
    customerEmail String required
    amount BigDecimal required
    currency String required
    paymentMethodId String required
}

input RetryPaymentInput {
    orderId String required
    /** PaymentFailed.attemptCount: the attempt that failed. */
    attemptCount Integer required
}

input ReauthorizePaymentInput {
    orderId String required
    /** PaymentRetried.attemptCount: equals the failed attempt; reauthorize increments it. */
    attemptCount Integer required
}

input GetPaymentStatusInput {
    orderId String required
}

enum GetPaymentStatusOutcome {
    NO_PAYMENT
    STARTED
}

/** Exactly one of `noPayment` / `started` is set, according to `outcome`. */
output GetPaymentStatusResult {
    outcome GetPaymentStatusOutcome required
    noPayment NoPaymentResult
    started PaymentStartedResult
}

output NoPaymentResult {
    orderId String
}

output PaymentStartedResult {
    orderId String
    status PaymentStatus
}

/** The payment is resolved by orderId (Payment.orderId is unique); fulfillment events carry no paymentId. */
input CapturePaymentInput {
    orderId String required
}

/** The payment is resolved by orderId (Payment.orderId is unique); fulfillment events carry no paymentId. */
input VoidPaymentInput {
    orderId String required
    reason String required
}

//@rest("/payments")
service PaymentsProcessingService for (Payment) {

    /**
     * Creation only: no-op when a Payment for orderId exists, in any state (supersedes P-01 D).
     * Saves AUTHORIZATION_REQUESTED (attemptCount = 1) and commits before calling the processor,
     * so getPaymentStatus sees a call in flight; then saves the outcome.
     * The processor call times out after 30 seconds and becomes PaymentFailed.
     */
    @listener(zdl: OrdersCheckoutZdl, event: OrderCreated)
    @transition(to: AUTHORIZATION_REQUESTED)
    @transition(from: AUTHORIZATION_REQUESTED, to: [AUTHORIZED, DECLINED, FAILED])
    authorizePayment(AuthorizePaymentInput) Payment withEvents [PaymentAuthorized | PaymentDeclined | PaymentFailed]

    /**
     * No-op unless FAILED and input.attemptCount == attemptCount. Increments attemptCount and commits
     * before calling the processor. The processor call times out after 30 seconds and becomes PaymentFailed.
     */
    @listener(event: PaymentRetried)
    @transition(from: FAILED, to: [AUTHORIZED, DECLINED, FAILED])
    reauthorizePayment(ReauthorizePaymentInput) Payment withEvents [PaymentAuthorized | PaymentDeclined | PaymentFailed]

    /**
     * No-op unless FAILED and input.attemptCount == attemptCount. Never increments attemptCount.
     * At most 3 attempts in all (authorize + reauthorize); backoff before the next attempt: 5 seconds
     * before attempt 2, 15 seconds before attempt 3. RETRY_EXHAUSTED at the limit.
     */
    @listener(event: PaymentFailed)
    @transition(from: FAILED, to: [FAILED, RETRY_EXHAUSTED])
    retryPayment(RetryPaymentInput) Payment withEvents [PaymentRetried | PaymentRetryExhausted]

    /** No-op, no event, when CAPTURED, CAPTURE_FAILED or VOIDED (redelivery). */
    @listener(zdl: FulfillmentShippingZdl, event: FulfillmentScheduled)
    @transition(from: AUTHORIZED, to: [CAPTURED, CAPTURE_FAILED])
    capturePayment(CapturePaymentInput) Payment withEvents [PaymentCaptured | PaymentCaptureFailed]

    /**
     * OrderCancelled is the safety net, OrderConfirmationRejected the late-authorization path.
     * No-op, no event, when there is no Payment or it is AUTHORIZATION_REQUESTED, VOIDED,
     * VOID_FAILED, DECLINED, RETRY_EXHAUSTED or CAPTURED. Voiding a FAILED payment is local (no hold).
     */
    @listener(zdl: OrdersCheckoutZdl, event: OrderCancelled)
    @listener(zdl: OrdersCheckoutZdl, event: OrderConfirmationRejected)
    @listener(zdl: FulfillmentShippingZdl, event: FulfillmentFailed)
    @listener(event: PaymentCaptureFailed)
    @transition(from: [AUTHORIZED, FAILED, CAPTURE_FAILED], to: [VOIDED, VOID_FAILED])
    voidPayment(VoidPaymentInput) Payment? withEvents [PaymentVoided | PaymentVoidFailed]

    /** Read only, for the reservation timer. STARTED for any existing Payment. */
    getPaymentStatus(GetPaymentStatusInput) GetPaymentStatusResult
}

// @asyncapi({ channel: "payment-authorized-event-v1", topic: "payments-processing.payment-authorized.event.avro.v1" })
event PaymentAuthorized {
    orderId String
    customerId String
    amount BigDecimal
    currency String
    providerReference String
    authorizedAt Instant
}

// @asyncapi({ channel: "payment-declined-event-v1", topic: "payments-processing.payment-declined.event.avro.v1" })
event PaymentDeclined {
    orderId String
    customerId String
    amount BigDecimal
    currency String
    reason String
    declinedAt Instant
}

// @asyncapi({ channel: "payment-failed-event-v1", topic: "payments-processing.payment-failed.event.avro.v1" })
event PaymentFailed {
    orderId String
    customerId String
    attemptCount Integer
    reason String
    failedAt Instant
}

// @asyncapi({ channel: "payment-retried-event-v1", topic: "payments-processing.payment-retried.event.avro.v1" })
event PaymentRetried {
    orderId String
    customerId String
    attemptCount Integer
    retriedAt Instant
}

// @asyncapi({ channel: "payment-retry-exhausted-event-v1", topic: "payments-processing.payment-retry-exhausted.event.avro.v1" })
event PaymentRetryExhausted {
    orderId String
    customerId String
    attemptCount Integer
    reason String
    exhaustedAt Instant
}

// @asyncapi({ channel: "payment-captured-event-v1", topic: "payments-processing.payment-captured.event.avro.v1" })
event PaymentCaptured {
    orderId String
    customerId String
    customerEmail String
    amount BigDecimal
    currency String
    providerReference String
    capturedAt Instant
}

// @asyncapi({ channel: "payment-capture-failed-event-v1", topic: "payments-processing.payment-capture-failed.event.avro.v1" })
event PaymentCaptureFailed {
    orderId String
    customerId String
    reason String
    failedAt Instant
}

// @asyncapi({ channel: "payment-voided-event-v1", topic: "payments-processing.payment-voided.event.avro.v1" })
event PaymentVoided {
    orderId String
    customerId String
    providerReference String
    reason String
    voidedAt Instant
}

/** Published for ops (manual follow-up) and consumed by releaseStock. */
// @asyncapi({ channel: "payment-void-failed-event-v1", topic: "payments-processing.payment-void-failed.event.avro.v1" })
event PaymentVoidFailed {
    orderId String
    customerId String
    providerReference String
    reason String
    failedAt Instant
}
