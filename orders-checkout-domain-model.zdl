config {
    id "urn:com.arcadiaeditions:orders:checkout"
    version "0.0.0"
    title "Arcadia Editions - Orders Checkout"
    moduleBasePackage "com.arcadiaeditions.orders.checkout"
    persistence jpa
    layout CleanHexagonalProjectLayout

    plugins {
        /** Generates an OpenAPI 3.0 specification from this ZDL model. */
        ZDLToOpenAPIPlugin {
            idType integer
            idTypeFormat int64
            openapiOverlayFiles "./orders-checkout-openapi-overlay.yml"
            targetFile "./orders-checkout-openapi.yml"
        }
    }
}

apis {
    zdl client PaymentsProcessingZdl "./payments-processing-domain-model.zdl"
    zdl client CatalogInventoryZdl "./catalog-inventory-domain-model.zdl"
}

@aggregate
@lifecycle(field: status, initial: CREATED)
entity Order(checkout_order) {
    orderId String required unique
    status OrderStatus required
    /** Customer snapshot taken at checkout (there is no customers bounded context yet). */
    customerId String required
    customerEmail String required maxlength(254)
    paymentMethodId String required
    @json items OrderItem[] required minlength(1) {
        sku String required
        quantity Integer required min(1)
        unitPrice BigDecimal required min(0) // client-sent (as designed for now); should come from catalog.products
    }
    @json shippingAddress ShippingAddress required {
        name String required
        line1 String required
        line2 String
        city String required
        region String
        postalCode String required
        country String required
    }
    totalAmount BigDecimal required
    currency String required maxlength(3)
    createdAt Instant
    confirmedAt Instant
    cancelledAt Instant
    cancellationReason String
}

enum OrderStatus {
    CREATED
    CONFIRMED
    CANCELLED
}

input StartOrderCheckoutInput {
    customerId String required
    customerEmail String required maxlength(254)
    paymentMethodId String required
    currency String required maxlength(3)
    items OrderItemInput[] required minlength(1) {
        sku String required
        quantity Integer required min(1)
        unitPrice BigDecimal required min(0) // client-sent (as designed for now); should come from catalog.products
    }
    shippingAddress ShippingAddressInput required {
        name String required
        line1 String required
        line2 String
        city String required
        region String
        postalCode String required
        country String required
    }
}

input ConfirmOrderInput {
    orderId String required
}

input CancelOrderInput {
    orderId String required
    /** From StockReleased.reason (StockReleaseReason name). */
    reason String required
}

@rest("/orders")
service OrdersCheckoutService for (Order) {

    /** Persists the Order only on OrderCreated; StockUnavailable answers 409 and persists nothing (P-03 A). */
    @post("/start-checkout")
    @transition(to: CREATED)
    @calls(zdl: CatalogInventoryZdl, command: InventoryService.reserveStock)
    startOrderCheckout(StartOrderCheckoutInput) Order withEvents [OrderCreated | StockUnavailable]

    /**
     * No-op on CONFIRMED (redelivery). On CANCELLED, or when the stock is no longer
     * held (NOT_HELD), the Order is not confirmed and OrderConfirmationRejected asks payments to void.
     */
    @listener(zdl: PaymentsProcessingZdl, event: PaymentAuthorized)
    @transition(from: CREATED, to: CONFIRMED)
    @calls(zdl: CatalogInventoryZdl, command: InventoryService.confirmStockReservation)
    confirmOrder(ConfirmOrderInput) Order withEvents [OrderConfirmed | OrderConfirmationRejected]

    /** No-op, no event, on CANCELLED (redelivered StockReleased). */
    @listener(zdl: CatalogInventoryZdl, event: StockReleased)
    @transition(from: [CREATED, CONFIRMED], to: CANCELLED)
    cancelOrder(CancelOrderInput) Order withEvents OrderCancelled

    @get("/{id}")
    getOrder(id) Order?
}

// @asyncapi({ channel: "order-created-event-v1", topic: "orders-checkout.order-created.event.avro.v1" })
event OrderCreated {
    orderId String
    version Integer
    customerId String
    customerEmail String
    paymentMethodId String
    /** Order total (Order.totalAmount), named to match AuthorizePaymentInput. */
    amount BigDecimal
    currency String
}

// @asyncapi({ channel: "stock-unavailable-event-v1", topic: "orders-checkout.stock-unavailable.event.avro.v1" })
event StockUnavailable {
    orderId String
    customerId String
    customerEmail String
    unavailableItems StockUnavailableItem[] {
        sku String
        requestedQuantity Integer
        availableQuantity Integer
    }
}

// @asyncapi({ channel: "order-confirmed-event-v1", topic: "orders-checkout.order-confirmed.event.avro.v1" })
event OrderConfirmed {
    orderId String
    version Integer
    customerId String
    confirmedAt Instant
    items OrderConfirmedItem[] {
        sku String
        quantity Integer
    }
    shippingAddress OrderConfirmedShippingAddress {
        name String
        line1 String
        line2 String
        city String
        region String
        postalCode String
        country String
    }
}

// @asyncapi({ channel: "order-cancelled-event-v1", topic: "orders-checkout.order-cancelled.event.avro.v1" })
event OrderCancelled {
    orderId String
    version Integer
    customerId String
    customerEmail String
    /** Order.cancellationReason */
    reason String
    cancelledAt Instant
}

/** The authorization arrived for an order that is cancelled or whose stock is no longer held; payments voids it. */
// @asyncapi({ channel: "order-confirmation-rejected-event-v1", topic: "orders-checkout.order-confirmation-rejected.event.avro.v1" })
event OrderConfirmationRejected {
    orderId String
    customerId String
    /** ORDER_CANCELLED or STOCK_NOT_HELD */
    reason String
    rejectedAt Instant
}
